{
  "//": "Vercel deployment configuration for the React frontend.",
  "//2": "Place this file in the frontend/ directory or set root to frontend/ in Vercel dashboard.",

  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "devCommand": "npm run dev",

  "rewrites": [
    {
      "//": "SPA fallback — all routes return index.html so React Router works.",
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
